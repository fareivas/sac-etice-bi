# Copie para .env.local e preencha apenas os valores locais necessários.
# Use Node.js >=20.12. Valores com # ou espaços devem ser colocados entre aspas.
# Host vazio: descoberta automática do gateway de docker network inspect bridge.
SAC_DB_HOST=
SAC_DB_PORT=5434
SAC_DB_NAME=sac
SAC_DB_USER=sac
SAC_DB_PASSWORD=
SAC_DB_SSL=false

# Harness de desenvolvimento; configure os IDs dos usuários do banco local.
LOCAL_FISCAL_USER_ID=4
LOCAL_MANAGER_USER_ID=4
