# Backend Node: credentials are supplied locally or by the deployment environment.
SAC_DB_HOST=
SAC_DB_PORT=
SAC_DB_NAME=
SAC_DB_USER=
SAC_DB_PASSWORD=
SAC_DB_SSL=false
# Set to true only when running the opt-in PostgreSQL integration test.
SAC_DB_INTEGRATION_TEST=false
# Temporary local Fiscal harness; active only with NODE_ENV=development or test.
# Set both values explicitly in the server environment. Never use in production.
LOCAL_FISCAL_USER_ID=
LOCAL_FISCAL_CAN_ACCESS_VIEW=

# Temporary local Manager harness; active only with NODE_ENV=development or test.
LOCAL_MANAGER_DASHBOARD_ENABLED=false
LOCAL_MANAGER_USER_ID=
LOCAL_MANAGER_CAN_ACCESS_VIEW=
